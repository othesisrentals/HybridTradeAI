// HybridTradeAI Database Schema
// Complete production-ready schema with all models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  password      String? // Hashed password for credentials provider
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(PENDING_VERIFICATION)

  // Balances
  investedBalance   Decimal @default(0) @db.Decimal(18, 2) // Locked investment amount
  withdrawalBalance Decimal @default(0) @db.Decimal(18, 2) // Available for withdrawal (profits)
  totalEarnings     Decimal @default(0) @db.Decimal(18, 2) // Lifetime earnings

  // KYC
  kycStatus     KYCStatus @default(PENDING)
  kycVerifiedAt DateTime?

  // Referral
  referralCode     String  @unique
  referredById     String? // User ID who referred this user
  referralEarnings Decimal @default(0) @db.Decimal(18, 2)

  // Two-Factor Authentication
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String? // TOTP secret (encrypted)
  twoFactorBackupCodes String[] @default([]) // Encrypted backup codes

  // Metadata
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  investments       Investment[]
  transactions      Transaction[]
  notifications     Notification[]
  kycDocuments      KycDocument[]
  adTaskCompletions AdTaskCompletion[]
  adStats           UserAdStats?
  aiConversations   AIConversation[]
  auditLogs         AuditLog[]
  referredBy        User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers     User[]             @relation("UserReferrals")

  @@index([email])
  @@index([referralCode])
  @@index([status])
  @@index([kycStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// INVESTMENT SYSTEM
// ============================================

enum PlanType {
  STARTER
  PRO
  ELITE
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PROFIT
  REFUND
  REFERRAL_BONUS
  AD_EARNING
  PLATFORM_FEE
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  type          PlanType @unique
  minAmount     Decimal  @db.Decimal(18, 2)
  maxAmount     Decimal  @db.Decimal(18, 2)
  roiMin        Decimal  @db.Decimal(5, 2) // e.g., 5.00 for 5%
  roiMax        Decimal  @db.Decimal(5, 2) // e.g., 12.00 for 12%
  durationWeeks Int // Investment duration in weeks
  managementFee Decimal  @default(10) @db.Decimal(5, 2) // 10% fee on profits

  // Plan features
  hasPremiumAds   Boolean @default(false) // Elite plan gets premium ad tasks
  prioritySupport Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  investments     Investment[]
  planAllocations PlanAllocation[]

  @@index([type])
  @@index([isActive])
}

model Investment {
  id     String           @id @default(cuid())
  userId String
  planId String
  amount Decimal          @db.Decimal(18, 2)
  status InvestmentStatus @default(PENDING)

  // Profit tracking
  totalProfitEarned Decimal   @default(0) @db.Decimal(18, 2)
  lastProfitDate    DateTime?
  nextProfitDate    DateTime?

  // Auto-investment tracking
  autoInvested   Boolean   @default(false)
  autoInvestedAt DateTime?

  // Dates
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan            @relation(fields: [planId], references: [id])
  transactions  Transaction[]
  profitHistory ProfitHistory[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([nextProfitDate])
}

model Transaction {
  id           String            @id @default(cuid())
  userId       String
  investmentId String?
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  amount       Decimal           @db.Decimal(18, 2)
  currency     String            @default("USD")

  // Payment details
  paymentMethod    String? // stripe, paystack, bank_transfer, etc.
  paymentReference String? @unique
  paymentGateway   String?

  // Metadata
  description String?
  adminNotes  String? // Admin notes for approval/rejection
  approvedBy  String? // Admin user ID
  approvedAt  DateTime?
  data        Json? // Additional structured data (planType, bank details, etc.)
  
  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment? @relation(fields: [investmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([investmentId])
  @@index([type])
  @@index([status])
  @@index([paymentReference])
  @@index([createdAt])
}

model ProfitHistory {
  id            String  @id @default(cuid())
  investmentId  String
  userId        String
  amount        Decimal @db.Decimal(18, 2)
  roiPercentage Decimal @db.Decimal(5, 2)
  managementFee Decimal @db.Decimal(18, 2)
  netProfit     Decimal @db.Decimal(18, 2) // Amount after fee

  // Revenue stream allocation
  revenueStreamId   String?
  allocationPercent Decimal? @db.Decimal(5, 2)

  distributedAt DateTime @default(now())
  weekNumber    Int // Week number since investment start

  // Relations
  investment    Investment     @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  revenueStream RevenueStream? @relation(fields: [revenueStreamId], references: [id])

  @@index([investmentId])
  @@index([userId])
  @@index([distributedAt])
  @@index([weekNumber])
}

// ============================================
// REVENUE STREAMS & ALLOCATIONS
// ============================================

enum RevenueStreamType {
  ALGORITHMIC_TRADING
  CRYPTO_STAKING
  COPY_TRADING
  ADVERTISING
  MANAGEMENT_FEES
}

model RevenueStream {
  id               String            @id @default(cuid())
  name             String
  type             RevenueStreamType @unique
  targetAllocation Decimal           @db.Decimal(5, 2) // e.g., 40.00 for 40%
  currentROI       Decimal           @default(0) @db.Decimal(5, 2)
  isActive         Boolean           @default(true)

  // Performance tracking
  totalRevenue Decimal @default(0) @db.Decimal(18, 2)
  totalProfit  Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  planAllocations PlanAllocation[]
  profitHistory   ProfitHistory[]

  @@index([type])
  @@index([isActive])
}

model PlanAllocation {
  id              String  @id @default(cuid())
  planId          String
  revenueStreamId String
  allocation      Decimal @db.Decimal(5, 2) // Percentage allocation

  plan          Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  revenueStream RevenueStream @relation(fields: [revenueStreamId], references: [id], onDelete: Cascade)

  @@unique([planId, revenueStreamId])
  @@index([planId])
  @@index([revenueStreamId])
}

// ============================================
// RESERVE BUFFER SYSTEM
// ============================================

model ReserveBuffer {
  id               String  @id @default(cuid())
  currentAmount    Decimal @db.Decimal(18, 2)
  targetPercentage Decimal @default(10) @db.Decimal(5, 2) // 10% of AUM
  totalAUM         Decimal @db.Decimal(18, 2) // Assets Under Management

  // Tracking
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([lastCalculatedAt])
}

// ============================================
// KYC VERIFICATION
// ============================================

enum DocumentType {
  PASSPORT
  DRIVERS_LICENSE
  NATIONAL_ID
  UTILITY_BILL
  BANK_STATEMENT
}

model KycDocument {
  id             String       @id @default(cuid())
  userId         String
  documentType   DocumentType
  documentNumber String?
  frontImageUrl  String
  backImageUrl   String?
  selfieImageUrl String?

  status          KYCStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String? // Admin user ID
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([documentType])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

enum NotificationType {
  INVESTMENT_APPROVED
  PROFIT_DISTRIBUTED
  DEPOSIT_CREATED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_CREATED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  ADMIN_BROADCAST
  AD_TASK_COMPLETED
  REFERRAL_BONUS
  SYSTEM_ALERT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Notification {
  id       String               @id @default(cuid())
  userId   String? // null for broadcast notifications
  type     NotificationType
  priority NotificationPriority @default(MEDIUM)
  title    String
  message  String               @db.Text
  link     String? // Optional link to related page

  // Metadata
  read   Boolean   @default(false)
  readAt DateTime?
  data   Json? // Additional structured data

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
  @@index([userId, read]) // Composite for unread queries
}

// ============================================
// ADMOB TASK SYSTEM
// ============================================

enum AdTaskType {
  VIDEO_AD
  SURVEY
  APP_INSTALL
  OFFER_WALL
  INTERSTITIAL
}

enum AdTaskStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AdCompletionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model AdTask {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  type        AdTaskType
  status      AdTaskStatus @default(ACTIVE)

  // Economics
  rewardAmount       Decimal @db.Decimal(18, 2) // User reward (70% of total)
  platformCommission Decimal @default(30) @db.Decimal(5, 2) // Platform keeps 30%
  totalEarning       Decimal @db.Decimal(18, 2) // Total ad revenue

  // Access control
  allowedPlans PlanType[] // Which plans can access this task
  requiredPlan PlanType? // Minimum plan required (null = all plans)

  // Limits
  dailyLimit         Int? // Per user daily limit
  totalLimit         Int? // Total completions allowed
  currentCompletions Int  @default(0)

  // Verification
  requiresVerification     Boolean @default(true)
  verificationInstructions String? @db.Text

  // Cooldown (hours)
  cooldownHours Int @default(24)

  // Ad network details
  adNetwork   String // admob, unity, ironsource
  adUnitId    String?
  trackingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  completions AdTaskCompletion[]

  @@index([status])
  @@index([type])
  @@index([requiredPlan])
}

model AdTaskCompletion {
  id       String             @id @default(cuid())
  userId   String
  adTaskId String
  status   AdCompletionStatus @default(PENDING_VERIFICATION)

  // Reward
  rewardAmount       Decimal @db.Decimal(18, 2)
  platformCommission Decimal @db.Decimal(18, 2)

  // Verification
  proofUrl        String? // Screenshot/proof of completion
  verifiedBy      String? // Admin user ID for manual verification
  verifiedAt      DateTime?
  rejectionReason String?

  // Tracking
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  adTask AdTask @relation(fields: [adTaskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adTaskId])
  @@index([status])
  @@index([completedAt])
  @@index([userId, adTaskId, completedAt]) // For daily limit checking
}

model UserAdStats {
  id                  String    @id @default(cuid())
  userId              String    @unique
  totalEarnings       Decimal   @default(0) @db.Decimal(18, 2)
  totalTasksCompleted Int       @default(0)
  lastTaskCompletedAt DateTime?

  // Daily tracking (reset daily)
  todayEarnings       Decimal  @default(0) @db.Decimal(18, 2)
  todayTasksCompleted Int      @default(0)
  lastResetDate       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// AI SUPPORT SYSTEM
// ============================================

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AIConversation {
  id         String    @id @default(cuid())
  userId     String
  title      String? // Auto-generated from first message
  isResolved Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([isResolved])
  @@index([createdAt])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text

  // AI metadata
  model        String? // e.g., "gpt-4", "claude-3"
  tokensUsed   Int?
  responseTime Int? // milliseconds

  createdAt DateTime @default(now())

  // Relations
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ============================================
// AUDIT & LOGGING
// ============================================

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  DEPOSIT_CREATED
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_CREATED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  INVESTMENT_CREATED
  INVESTMENT_COMPLETED
  PROFIT_DISTRIBUTED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  AD_TASK_CREATED
  AD_TASK_COMPLETED
  REVENUE_STREAM_UPDATED
  RESERVE_BUFFER_UPDATED
  ADMIN_ACTION
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String? // User who performed action (null for system)
  targetUserId String? // User affected by action
  action       AuditAction
  entityType   String // e.g., "User", "Investment", "Transaction"
  entityId     String?
  description  String      @db.Text
  metadata     Json? // Additional structured data
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
