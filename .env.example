# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hybridtradeai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-32-character-jwt-secret-key-here"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Ad Networks
ADMOB_APP_ID="ca-app-pub-..."
ADMOB_AD_UNIT_ID="ca-app-pub-..."
ADMOB_API_KEY="..."

# Email (Resend)
RESEND_API_KEY="re_..."

# AI
OPENAI_API_KEY="sk-..."
# or
ANTHROPIC_API_KEY="sk-ant-..."

# Currency Conversion (Fixer.io)
FX_API_KEY="your_fixer_api_key_here" # Get from https://fixer.io

# Payment Gateway - Paystack
PAYSTACK_SECRET_KEY="sk_test_..." # Test: sk_test_, Live: sk_live_

# Payment Gateway - Flutterwave  
FLUTTERWAVE_SECRET_KEY="FLWSECK-..." # Get from Flutterwave dashboard
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-..." # Get from Flutterwave dashboard

# Payment Gateway - Coinbase Commerce (Crypto)
COINBASE_COMMERCE_API_KEY="..." # Get from Coinbase Commerce
COINBASE_WEBHOOK_SECRET="..." # Get from Coinbase Commerce webhook settings

# Optional - Monitoring & Analytics
SENTRY_DSN="https://..."

# App Configuration
NEXT_PUBLIC_APP_NAME="HybridTradeAI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
