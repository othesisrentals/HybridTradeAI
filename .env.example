# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/hybridtradeai?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_SECRET="your-32-character-secret-key-here-change-this"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="another-32-character-secret-key-here"

# ============================================
# PAYMENTS (STRIPE)
# ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Paystack
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."

# ============================================
# AD NETWORKS
# ============================================
# Google AdMob
ADMOB_APP_ID="ca-app-pub-..."
ADMOB_AD_UNIT_ID="ca-app-pub-..."
ADMOB_API_KEY="..."

# Unity Ads
UNITY_GAME_ID="..."
UNITY_API_KEY="..."

# IronSource
IRONSOURCE_APP_KEY="..."
IRONSOURCE_SECRET_KEY="..."

# ============================================
# AI / OPENAI
# ============================================
OPENAI_API_KEY="sk-..."
OPENAI_ORGANIZATION=""

# Optional: Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# ============================================
# EMAIL
# ============================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@hybridtradeai.com"
SUPPORT_EMAIL="support@hybridtradeai.com"

# ============================================
# FILE STORAGE (CLOUDINARY)
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Optional: Sentry
SENTRY_DSN="https://...@sentry.io/..."
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# Optional: Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."

# ============================================
# CURRENCY & FOREX
# ============================================
# Optional: For multi-currency support
FX_API_KEY="..."
DEFAULT_CURRENCY="USD"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HybridTradeAI"

# Profit distribution schedule (cron format)
PROFIT_DISTRIBUTION_CRON="0 2 * * 0" # Every Sunday at 2 AM

# Platform fees
MANAGEMENT_FEE_PERCENT="10"
AD_PLATFORM_FEE_PERCENT="30"

# Reserve buffer
RESERVE_BUFFER_PERCENT="10"

# Admin emails (comma-separated)
ADMIN_EMAILS="admin@hybridtradeai.com"

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV="development"
LOG_LEVEL="debug"
