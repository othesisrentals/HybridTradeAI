# Email (Resend)
RESEND_API_KEY="re_..."

# AI
OPENAI_API_KEY="sk-..."
# or
ANTHROPIC_API_KEY="sk-ant-..."

# Currency Exchange API
FIXER_API_KEY="..." # Fixer.io API key
FX_API_KEY="..." # Alternative: ExchangeRate-API (free tier available)
