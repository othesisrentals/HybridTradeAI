# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hybridtradeai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
NEXTAUTH_SECRET="your-32-character-secret-key-here"
